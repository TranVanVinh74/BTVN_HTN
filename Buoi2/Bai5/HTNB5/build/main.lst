 122:Core/Src/main.c **** /* Xử lý lệnh nhận được */
 123:Core/Src/main.c **** void Process_Command(void)
 124:Core/Src/main.c **** {
 125:Core/Src/main.c ****     /* ---------- ON ---------- */
 126:Core/Src/main.c ****     if(strcmp(rx_buffer, "ON") == 0)
 127:Core/Src/main.c ****     {
 128:Core/Src/main.c ****         led_on = 1;
 129:Core/Src/main.c **** 
 130:Core/Src/main.c ****         /* Khôi phục mức PWM gần nhất */
 131:Core/Src/main.c ****         Set_PWM(pwm_percent);
 132:Core/Src/main.c **** 
 133:Core/Src/main.c ****         UART_Send_String("LED ON\r\n");
 134:Core/Src/main.c ****     }
 135:Core/Src/main.c **** 
 136:Core/Src/main.c ****     /* ---------- OFF ---------- */
 137:Core/Src/main.c ****     else if(strcmp(rx_buffer, "OFF") == 0)
 138:Core/Src/main.c ****     {
 139:Core/Src/main.c ****         led_on = 0;
 140:Core/Src/main.c **** 
 141:Core/Src/main.c ****         /* Tắt LED thực tế */
 142:Core/Src/main.c ****         Set_PWM(0);
 143:Core/Src/main.c **** 
 144:Core/Src/main.c ****         UART_Send_String("LED OFF\r\n");
 145:Core/Src/main.c ****     }
 146:Core/Src/main.c **** 
 147:Core/Src/main.c ****     /* ---------- PWM:xx ---------- */
ARM GAS  /tmp/ccVFKevP.s 			page 4


 148:Core/Src/main.c ****     else if(strncmp(rx_buffer, "PWM:", 4) == 0)
 149:Core/Src/main.c ****     {
 150:Core/Src/main.c ****         int value;
 151:Core/Src/main.c **** 
 152:Core/Src/main.c ****         value = atoi(&rx_buffer[4]);
 153:Core/Src/main.c **** 
 154:Core/Src/main.c ****         if(value >= 0 && value <= 100)
 155:Core/Src/main.c ****         {
 156:Core/Src/main.c ****             /*
 157:Core/Src/main.c ****              * Luôn cập nhật giá trị PWM đã cấu hình,
 158:Core/Src/main.c ****              * kể cả khi LED đang OFF.
 159:Core/Src/main.c ****              */
 160:Core/Src/main.c ****             pwm_percent = (uint8_t)value;
 161:Core/Src/main.c **** 
 162:Core/Src/main.c ****             /*
 163:Core/Src/main.c ****              * Chỉ thay đổi độ sáng thực tế
 164:Core/Src/main.c ****              * nếu LED đang ON.
 165:Core/Src/main.c ****              */
 166:Core/Src/main.c ****             if(led_on)
 167:Core/Src/main.c ****             {
 168:Core/Src/main.c ****                 Set_PWM(pwm_percent);
 169:Core/Src/main.c ****             }
 170:Core/Src/main.c **** 
 171:Core/Src/main.c ****             sprintf(tx_buffer,
 172:Core/Src/main.c ****                     "PWM = %d%%\r\n",
 173:Core/Src/main.c ****                     pwm_percent);
 174:Core/Src/main.c **** 
 175:Core/Src/main.c ****             UART_Send_String(tx_buffer);
 176:Core/Src/main.c ****         }
 177:Core/Src/main.c ****         else
 178:Core/Src/main.c ****         {
 179:Core/Src/main.c ****             UART_Send_String("PWM invalid\r\n");
 180:Core/Src/main.c ****         }
 181:Core/Src/main.c ****     }
 182:Core/Src/main.c **** 
 183:Core/Src/main.c ****     /* ---------- Status ---------- */
 184:Core/Src/main.c ****     else if(strcmp(rx_buffer, "Status") == 0)
 185:Core/Src/main.c ****     {
 186:Core/Src/main.c ****         if(led_on)
 187:Core/Src/main.c ****         {
 188:Core/Src/main.c ****             sprintf(tx_buffer,
 189:Core/Src/main.c ****                     "LED: ON, PWM: %d%%\r\n",
 190:Core/Src/main.c ****                     pwm_percent);
 191:Core/Src/main.c ****         }
 192:Core/Src/main.c ****         else
 193:Core/Src/main.c ****         {
 194:Core/Src/main.c ****             sprintf(tx_buffer,
 195:Core/Src/main.c ****                     "LED: OFF, PWM: %d%%\r\n",
 196:Core/Src/main.c ****                     pwm_percent);
 197:Core/Src/main.c ****         }
 198:Core/Src/main.c **** 
 199:Core/Src/main.c ****         UART_Send_String(tx_buffer);
 200:Core/Src/main.c ****     }
 201:Core/Src/main.c **** 
 202:Core/Src/main.c ****     /* ---------- Sai lệnh ---------- */
 203:Core/Src/main.c ****     else
 204:Core/Src/main.c ****     {
ARM GAS  /tmp/ccVFKevP.s 			page 5


 205:Core/Src/main.c ****         UART_Send_String("Unknown command\r\n");
 206:Core/Src/main.c ****     }
 207:Core/Src/main.c **** }

 210:Core/Src/main.c **** /* Callback UART nhận xong 1 byte */
 211:Core/Src/main.c **** void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
 212:Core/Src/main.c **** {
 213:Core/Src/main.c ****     if(huart->Instance == USART1)
 214:Core/Src/main.c ****     {
 215:Core/Src/main.c ****         /* Nếu gặp dấu ! -> kết thúc lệnh */
 216:Core/Src/main.c ****         if(rx_data == '!')
 217:Core/Src/main.c ****         {
 218:Core/Src/main.c ****             rx_buffer[rx_index] = '\0';
 219:Core/Src/main.c **** 
 220:Core/Src/main.c ****             command_ready = 1;
 221:Core/Src/main.c **** 
 222:Core/Src/main.c ****             /*
 223:Core/Src/main.c ****              * Không nhận tiếp ngay ở đây.
 224:Core/Src/main.c ****              * Chờ main xử lý xong lệnh rồi nhận tiếp.
 225:Core/Src/main.c ****              */
 226:Core/Src/main.c ****         }
 227:Core/Src/main.c ****         else
 228:Core/Src/main.c ****         {
 229:Core/Src/main.c ****             /*
 230:Core/Src/main.c ****              * Chỉ lưu nếu buffer chưa đầy.
 231:Core/Src/main.c ****              */
 232:Core/Src/main.c ****             if(rx_index < RX_BUFFER_SIZE - 1)
 233:Core/Src/main.c ****             {
 234:Core/Src/main.c ****                 rx_buffer[rx_index] = rx_data;
 235:Core/Src/main.c ****                 rx_index++;
 236:Core/Src/main.c ****             }
 237:Core/Src/main.c **** 
 238:Core/Src/main.c ****             /*
 239:Core/Src/main.c ****              * Tiếp tục nhận byte tiếp theo.
 240:Core/Src/main.c ****              */
 241:Core/Src/main.c ****             HAL_UART_Receive_IT(&huart1,
 242:Core/Src/main.c ****                                 &rx_data,
 243:Core/Src/main.c ****                                 1);
 244:Core/Src/main.c ****         }
 245:Core/Src/main.c ****     }
 246:Core/Src/main.c **** }
 247:Core/Src/main.c **** 

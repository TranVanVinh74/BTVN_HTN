  86:Core/Src/main.c **** /* Hàm đặt duty PWM từ 0 -> 100% */
  87:Core/Src/main.c **** void Set_PWM(uint8_t percent)
  88:Core/Src/main.c **** {
  89:Core/Src/main.c ****     uint32_t compare;
  90:Core/Src/main.c **** 
ARM GAS  /tmp/ccVFKevP.s 			page 3


  91:Core/Src/main.c ****     if(percent > 100)
  92:Core/Src/main.c ****     {
  93:Core/Src/main.c ****         percent = 100;
  94:Core/Src/main.c ****     }
  95:Core/Src/main.c **** 
  96:Core/Src/main.c ****     /*
  97:Core/Src/main.c ****      * ARR = 999
  98:Core/Src/main.c ****      * => tổng 1000 count
  99:Core/Src/main.c ****      *
 100:Core/Src/main.c ****      * 10%  = 100
 101:Core/Src/main.c ****      * 50%  = 500
 102:Core/Src/main.c ****      * 100% = 1000
 103:Core/Src/main.c ****      */
 104:Core/Src/main.c ****     compare = percent * 10;
 105:Core/Src/main.c **** 
 106:Core/Src/main.c ****     __HAL_TIM_SET_COMPARE(&htim2,
 107:Core/Src/main.c ****                           TIM_CHANNEL_1,
 108:Core/Src/main.c ****                           compare);
 109:Core/Src/main.c **** }

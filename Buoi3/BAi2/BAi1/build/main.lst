 166:Core/Src/main.c **** void TFT_WriteCmd(uint8_t cmd) {
 167:Core/Src/main.c ****     TFT_DC_CMD();
 168:Core/Src/main.c ****     TFT_CS_LOW();
 169:Core/Src/main.c ****     HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
 170:Core/Src/main.c ****     TFT_CS_HIGH();
 171:Core/Src/main.c **** }
 172:Core/Src/main.c **** 
 173:Core/Src/main.c **** void TFT_WriteData(uint8_t data) {
 174:Core/Src/main.c ****     TFT_DC_DATA();
 175:Core/Src/main.c ****     TFT_CS_LOW();
 176:Core/Src/main.c ****     HAL_SPI_Transmit(&hspi1, &data, 1, HAL_MAX_DELAY);
 177:Core/Src/main.c ****     TFT_CS_HIGH();
 178:Core/Src/main.c **** }

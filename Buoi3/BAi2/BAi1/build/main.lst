 180:Core/Src/main.c **** void TFT_SetAddressWindow(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1) {
 181:Core/Src/main.c ****     TFT_WriteCmd(0x2A); // CASET
 182:Core/Src/main.c ****     TFT_WriteData(x0 >> 8);
 183:Core/Src/main.c ****     TFT_WriteData(x0 & 0xFF);
 184:Core/Src/main.c ****     TFT_WriteData(x1 >> 8);
 185:Core/Src/main.c ****     TFT_WriteData(x1 & 0xFF);
 186:Core/Src/main.c **** 
 187:Core/Src/main.c ****     TFT_WriteCmd(0x2B); // RASET
 188:Core/Src/main.c ****     TFT_WriteData(y0 >> 8);
 189:Core/Src/main.c ****     TFT_WriteData(y0 & 0xFF);
 190:Core/Src/main.c ****     TFT_WriteData(y1 >> 8);
 191:Core/Src/main.c ****     TFT_WriteData(y1 & 0xFF);
 192:Core/Src/main.c **** 
 193:Core/Src/main.c ****     TFT_WriteCmd(0x2C); // RAMWR
 194:Core/Src/main.c **** }
 195:Core/Src/main.c **** 
 196:Core/Src/main.c **** void TFT_Init(void) {
 197:Core/Src/main.c ****     // Reset phần cứng
 198:Core/Src/main.c ****     TFT_RES_LOW();
 199:Core/Src/main.c ****     HAL_Delay(50);
 200:Core/Src/main.c ****     TFT_RES_HIGH();
 201:Core/Src/main.c ****     HAL_Delay(50);
 202:Core/Src/main.c **** 
 203:Core/Src/main.c ****     TFT_WriteCmd(0x01); // SWRESET
 204:Core/Src/main.c ****     HAL_Delay(150);
ARM GAS  /tmp/cctKnHFV.s 			page 5


 205:Core/Src/main.c **** 
 206:Core/Src/main.c ****     TFT_WriteCmd(0x11); // SLPOUT (Thoát Sleep mode)
 207:Core/Src/main.c ****     HAL_Delay(200);
 208:Core/Src/main.c **** 
 209:Core/Src/main.c ****     // Cấu hình định dạng màu 16-bit (RGB565)
 210:Core/Src/main.c ****     TFT_WriteCmd(0x3A);
 211:Core/Src/main.c ****     TFT_WriteData(0x05);
 212:Core/Src/main.c **** 
 213:Core/Src/main.c ****     // Cấu hình hướng quét hiển thị (MADCTL)
 214:Core/Src/main.c ****     TFT_WriteCmd(0x36);
 215:Core/Src/main.c ****     TFT_WriteData(0xC0); // Tùy module có thể là 0x00, 0xC8, hoặc 0xA0
 216:Core/Src/main.c **** 
 217:Core/Src/main.c ****     TFT_WriteCmd(0x29); // DISPON (Bật hiển thị)
 218:Core/Src/main.c ****     HAL_Delay(100);
 219:Core/Src/main.c **** }
 220:Core/Src/main.c **** 
 221:Core/Src/main.c **** void TFT_DrawPixel(uint16_t x, uint16_t y, uint16_t color) {
 222:Core/Src/main.c ****     if (x >= TFT_WIDTH || y >= TFT_HEIGHT) return;
 223:Core/Src/main.c ****     TFT_SetAddressWindow(x, y, x, y);
 224:Core/Src/main.c ****     TFT_DC_DATA();
 225:Core/Src/main.c ****     TFT_CS_LOW();
 226:Core/Src/main.c ****     uint8_t data[2] = { color >> 8, color & 0xFF };
 227:Core/Src/main.c ****     HAL_SPI_Transmit(&hspi1, data, 2, HAL_MAX_DELAY);
 228:Core/Src/main.c ****     TFT_CS_HIGH();
 229:Core/Src/main.c **** }
 230:Core/Src/main.c **** 
 231:Core/Src/main.c **** void TFT_FillScreen(uint16_t color) {
 232:Core/Src/main.c ****     TFT_SetAddressWindow(0, 0, TFT_WIDTH - 1, TFT_HEIGHT - 1);
 233:Core/Src/main.c ****     TFT_DC_DATA();
 234:Core/Src/main.c ****     TFT_CS_LOW();
 235:Core/Src/main.c ****     uint8_t colorData[2] = { color >> 8, color & 0xFF };
 236:Core/Src/main.c ****     for (uint32_t i = 0; i < (uint32_t)(TFT_WIDTH * TFT_HEIGHT); i++) {
 237:Core/Src/main.c ****         HAL_SPI_Transmit(&hspi1, colorData, 2, HAL_MAX_DELAY);
 238:Core/Src/main.c ****     }
 239:Core/Src/main.c ****     TFT_CS_HIGH();
 240:Core/Src/main.c **** }
 241:Core/Src/main.c **** 
 242:Core/Src/main.c **** // Vẽ 1 ký tự ASCII (hỗ trợ phóng to tỉ lệ size)
 243:Core/Src/main.c **** void TFT_DrawChar(uint16_t x, uint16_t y, char c, uint16_t color, uint16_t bg, uint8_t size) {
 244:Core/Src/main.c ****     if (c < ' ' || c > 'z') return;
 245:Core/Src/main.c ****     uint8_t charIndex = c - ' ';
 246:Core/Src/main.c **** 
 247:Core/Src/main.c ****     for (int8_t i = 0; i < 5; i++) {
 248:Core/Src/main.c ****         uint8_t line = Font5x7[charIndex][i];
 249:Core/Src/main.c ****         for (int8_t j = 0; j < 8; j++) {
 250:Core/Src/main.c ****             if (line & 0x01) {
 251:Core/Src/main.c ****                 if (size == 1) {
 252:Core/Src/main.c ****                     TFT_DrawPixel(x + i, y + j, color);
 253:Core/Src/main.c ****                 } else {
 254:Core/Src/main.c ****                     for (uint8_t a = 0; a < size; a++) {
 255:Core/Src/main.c ****                         for (uint8_t b = 0; b < size; b++) {
 256:Core/Src/main.c ****                             TFT_DrawPixel(x + (i * size) + a, y + (j * size) + b, color);
 257:Core/Src/main.c ****                         }
 258:Core/Src/main.c ****                     }
 259:Core/Src/main.c ****                 }
 260:Core/Src/main.c ****             } else if (bg != color) {
 261:Core/Src/main.c ****                 if (size == 1) {
ARM GAS  /tmp/cctKnHFV.s 			page 6


 262:Core/Src/main.c ****                     TFT_DrawPixel(x + i, y + j, bg);
 263:Core/Src/main.c ****                 } else {
 264:Core/Src/main.c ****                     for (uint8_t a = 0; a < size; a++) {
 265:Core/Src/main.c ****                         for (uint8_t b = 0; b < size; b++) {
 266:Core/Src/main.c ****                             TFT_DrawPixel(x + (i * size) + a, y + (j * size) + b, bg);
 267:Core/Src/main.c ****                         }
 268:Core/Src/main.c ****                     }
 269:Core/Src/main.c ****                 }
 270:Core/Src/main.c ****             }
 271:Core/Src/main.c ****             line >>= 1;
 272:Core/Src/main.c ****         }
 273:Core/Src/main.c ****     }
 274:Core/Src/main.c **** }
 275:Core/Src/main.c **** 
 276:Core/Src/main.c **** // In chuỗi ký tự lên màn hình
 277:Core/Src/main.c **** void TFT_PrintString(uint16_t x, uint16_t y, const char *str, uint16_t color, uint16_t bg, uint8_t 
 278:Core/Src/main.c ****     while (*str) {
 279:Core/Src/main.c ****         TFT_DrawChar(x, y, *str, color, bg, size);

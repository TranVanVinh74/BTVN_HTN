 111:Core/Src/main.c ****   // 1. Hiệu chuẩn ADC để phần cứng đọc chuẩn xác (Rất quan trọng trên dòng 
 112:Core/Src/main.c ****   HAL_ADCEx_Calibration_Start(&hadc1);
 113:Core/Src/main.c **** 
 114:Core/Src/main.c ****   // 2. Khởi động ADC nhận dữ liệu qua DMA (Chế độ Circular)
 115:Core/Src/main.c ****   HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, TOTAL_SAMPLES);
 116:Core/Src/main.c **** 
 117:Core/Src/main.c ****   // 3. Khởi động Timer 2 kênh Compare 2 để phát xung trigger 100Hz sang ADC
 118:Core/Src/main.c ****   HAL_TIM_OC_Start(&htim2, TIM_CHANNEL_2);
 119:Core/Src/main.c ****   /* USER CODE END 2 */
 120:Core/Src/main.c **** 
 121:Core/Src/main.c ****   /* Infinite loop */
 122:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 123:Core/Src/main.c ****   while (1)
 124:Core/Src/main.c ****   {
 125:Core/Src/main.c ****     /* USER CODE END WHILE */
 126:Core/Src/main.c **** 
 127:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 128:Core/Src/main.c ****     // Khi đầy 50 mẫu đầu (Half-transfer complete)
 129:Core/Src/main.c ****     if (send_first_half_flag)
 130:Core/Src/main.c ****     {
 131:Core/Src/main.c ****         send_first_half_flag = 0;
 132:Core/Src/main.c ****         for (int i = 0; i < HALF_SAMPLES; i++)
 133:Core/Src/main.c ****         {
 134:Core/Src/main.c ****             int len = snprintf(uart_msg, sizeof(uart_msg), "%u\r\n", adc_buffer[i]);
 135:Core/Src/main.c ****             HAL_UART_Transmit(&huart1, (uint8_t*)uart_msg, len, 50);
 136:Core/Src/main.c ****         }
 137:Core/Src/main.c ****     }
 138:Core/Src/main.c **** 
 139:Core/Src/main.c ****     // Khi đầy 50 mẫu sau (Transfer-complete)
 140:Core/Src/main.c ****     if (send_second_half_flag)
 141:Core/Src/main.c ****     {
 142:Core/Src/main.c ****         send_second_half_flag = 0;
 143:Core/Src/main.c ****         for (int i = HALF_SAMPLES; i < TOTAL_SAMPLES; i++)
 144:Core/Src/main.c ****         {
 145:Core/Src/main.c ****             int len = snprintf(uart_msg, sizeof(uart_msg), "%u\r\n", adc_buffer[i]);
 146:Core/Src/main.c ****             HAL_UART_Transmit(&huart1, (uint8_t*)uart_msg, len, 50);
 147:Core/Src/main.c ****         }
ARM GAS  /tmp/ccvN1TeP.s 			page 4


 148:Core/Src/main.c ****     }
 149:Core/Src/main.c ****   }
